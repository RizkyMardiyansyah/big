# ===== Server =====
PORT=4000
APP_URL=http://localhost:5174
WEB_PORT=5174
# Login memakai session (cookie httpOnly). Masa berlaku sliding (hari) dan batas maksimum sejak login (hari)
SESSION_DAYS=7
SESSION_MAX_DAYS=30
STORAGE_DIR=./storage
# true = server menjalankan migrasi + data awal otomatis saat start (set false untuk produksi yang ketat)
AUTO_MIGRATE=true

# ===== Database (ganti DB cukup dengan mengubah bagian ini) =====
# Klien: mssql | pg | mysql2 | sqlite3 | oracledb  (selain mssql: npm i <driver>)
DB_CLIENT=mssql
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=
DB_NAME=big
# Khusus MSSQL
DB_ENCRYPT=false
DB_TRUST_CERT=true
# Opsional: connection string penuh (pg/mysql2). Jika diisi, mengalahkan DB_HOST dst.
DB_URL=
# Khusus sqlite3
DB_FILE=./big.sqlite

# ===== Frontend (opsional) =====
# VITE_API_URL=/api

# ===== Deploy di Vercel (frontend + API dalam satu proyek) =====
# Database harus bisa diakses dari internet (mis. Postgres Neon/Supabase: DB_CLIENT=pg, DB_URL=postgres://...?sslmode=require).
# Isi variabel ini di Vercel > Settings > Environment Variables:
#   DB_CLIENT, DB_URL (atau DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME), APP_URL=https://domain-anda.vercel.app,
#   AUTO_MIGRATE=false, SESSION_DAYS, SESSION_MAX_DAYS
# Migrasi dan data awal dijalankan SEKALI dari komputer Anda (DB_* menunjuk ke database online):
#   npm run db:migrate && npm run db:seed && ADMIN_PASSWORD='...' npm run create-admin -- admin@perusahaan.com "Nama Admin"
